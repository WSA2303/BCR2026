boundaryField
{
    inlet_water
    {
        type            fixedValue;
        value           uniform 1;
    }
    inlet_air
    {
        type            fixedValue;
        value           uniform 0;
    }
    outlet_water
    {
        type            zeroGradient;
    }
    outlet_air
    {
        type            zeroGradient;
    }
    lowerWall
    {
        type            zeroGradient;
    }
    atmosphere
    {
        type            inletOutlet;
        inletValue      uniform 0;
        value           uniform 0;
    }
    defaultFaces
    {
        type            empty;
    }
}


