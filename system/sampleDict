FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      sample;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include "./setUp/parameters"

type sets;
libs            ("libsampling.so");

interpolationScheme cellPoint;

setFormat       csv;

fields          (U p_rgh alpha.concrete nu1);

sets
(
    data
    {
        type    lineUniform;
        axis    z;
        start   ($Lx 0 0);
        end     ($Lx  0 $Lz);
        nPoints 1000;
    }
);


