   ($Lx     0            $Lz_2) //ponto 9
   (0       $Ly          $Lz_2) //ponto 10
   ($Lx     $Ly          $Lz_2) //ponto 11
   (0       0            $Lz_3)   //ponto 12
   ($Lx     0            $Lz_3)   //ponto 13
   (0       $Ly          $Lz_3)   //ponto 14
