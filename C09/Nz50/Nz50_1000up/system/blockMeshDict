(
    patch inlet_water
    (
        (0 4 6 2)
    )
    patch inlet_air
    (
	(4 8  10 6)
	(8 12 14 10)
    )
    patch outlet_water
    (
	(1 3 7 5)
    )
    patch outlet_air
    (
        (5 7  11 9)
	(9 11 15 13)
    )
    wall lowerWall
    (
        (0 2 3 1)
    )
    wall atmosphere
    (
        (12 14 15 13)
    )
    );
    
    defaulfaces
    {
        type empty; //Pois é um modelo 2D, se for 3D usar mesmas condicoes do fundo
