#include "./setUp/parameters"

convertToMeters 1;

//Number of volumes
nx 	 	$numOfVol_x;
nz_1 	 	$numOfVol_concrete;
nz_2 	 	$numOfVol_interface;
nz_3 	 	$numOfVol_Air;


//Geometry
Ly              $h0; 
